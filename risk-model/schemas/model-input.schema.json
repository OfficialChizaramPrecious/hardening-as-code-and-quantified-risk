{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-input.schema.json",
  "title": "Stage 8 quantitative risk model input",
  "description": "Assets, parameterised risks, and candidate treatments. Numeric relationships (min <= mode <= max, control bounds, positive dependency multipliers) are enforced by validate.py against the published contract; this schema enforces structure and types only.",
  "type": "object",
  "required": ["schema_version", "risks", "treatments"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "project": { "type": "string" },
    "evidence_marker": { "type": "string", "minLength": 1 },
    "budget": { "type": "number", "minimum": 0 },
    "required_treatment_count": { "type": "integer", "minimum": 1 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id"],
        "additionalProperties": true,
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "criticality": { "type": "string" },
          "environment": { "type": "string" },
          "estimated_records": { "type": "integer", "minimum": 0 },
          "annual_revenue_dependency_usd": { "type": "number", "minimum": 0 }
        }
      }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "risk_id",
          "asset_id",
          "freq_min",
          "freq_mode",
          "freq_max",
          "loss_min",
          "loss_mode",
          "loss_max",
          "control_min",
          "control_max",
          "dependency_multiplier"
        ],
        "additionalProperties": true,
        "properties": {
          "risk_id": { "type": "string", "minLength": 1 },
          "asset_id": { "type": "string", "minLength": 1 },
          "source_finding_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Traceability back to the supplied export. Carried as data only; implementation logic never branches on these values."
          },
          "freq_min": { "type": "number", "minimum": 0 },
          "freq_mode": { "type": "number", "minimum": 0 },
          "freq_max": { "type": "number", "minimum": 0 },
          "loss_min": { "type": "number", "minimum": 0 },
          "loss_mode": { "type": "number", "minimum": 0 },
          "loss_max": { "type": "number", "minimum": 0 },
          "control_min": { "type": "number", "minimum": 0, "maximum": 1 },
          "control_max": { "type": "number", "minimum": 0, "maximum": 1 },
          "dependency_multiplier": { "type": "number", "exclusiveMinimum": 0 },
          "rationale": {
            "type": "string",
            "description": "Why these ranges, tied to asset criticality, records at risk, revenue dependency, exploit evidence quality and existing controls."
          }
        }
      }
    },
    "treatments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "risk_id",
          "cost",
          "treated_control_min",
          "treated_control_max"
        ],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "risk_id": { "type": "string", "minLength": 1 },
          "cost": { "type": "number", "minimum": 0 },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "treated_control_min": { "type": "number", "minimum": 0, "maximum": 1 },
          "treated_control_max": { "type": "number", "minimum": 0, "maximum": 1 },
          "description": { "type": "string" },
          "rationale": {
            "type": "string",
            "description": "Why this control range is achievable after implementation."
          }
        }
      }
    }
  }
}